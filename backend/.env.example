# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/food-ordering-system
# Atlas:  mongodb+srv://<username>:<password>@<cluster-url>/food-ordering-system?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/food-ordering-system

# Port the backend server runs on
PORT=5000

# Secret used to sign JWT tokens - change this to a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins for CORS
CLIENT_URL=http://localhost:5173
